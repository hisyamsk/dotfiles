/* Kanagawa — monotone, matches waybar */
* {
    bg:       #1F1F28; /* sumiInk1    */
    surface:  #2A2A37; /* sumiInk2    */
    overlay:  #363646; /* sumiInk3    */
    fg:       #DCD7BA; /* fujiWhite   */
    muted:    #727169; /* fujiGray    */
    accent:   #7E9CD8; /* crystalBlue */
    crit:     #E46876; /* waveRed     */

    font:             "JetBrainsMono Nerd Font 11";
    background-color: transparent;
    text-color:       @fg;
    margin:           0;
    padding:          0;
    spacing:          0;
}

window {
    location:         center;
    width:            560px;
    background-color: @bg;
    border:           1px;
    border-color:     @overlay;
    border-radius:    6px;
}

mainbox {
    children: [ inputbar, message, listview ];
}

inputbar {
    children:         [ prompt, entry ];
    spacing:          12px;
    padding:          12px 16px;
    background-color: @surface;
    border:           0 0 1px 0;
    border-color:     @overlay;
}

prompt {
    text-color: @accent;
}

entry {
    placeholder:       "Search";
    placeholder-color: @muted;
    cursor:            text;
}

message {
    padding:      8px 16px;
    border:       0 0 1px 0;
    border-color: @overlay;
}

textbox {
    text-color: @muted;
}

listview {
    lines:        8;
    columns:      1;
    fixed-height: true;
    dynamic:      false;
    scrollbar:    false;
    cycle:        true;
    padding:      6px;
    spacing:      2px;
}

element {
    padding:       8px 10px;
    spacing:       12px;
    border-radius: 4px;
    cursor:        pointer;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color:       @fg;
}

element normal.urgent,
element alternate.urgent,
element selected.urgent {
    text-color: @crit;
}

element normal.active,
element alternate.active {
    text-color: @accent;
}

element selected.normal,
element selected.active {
    background-color: @overlay;
    text-color:       @fg;
}

element-icon {
    size:             18px;
    vertical-align:   0.5;
    background-color: inherit;
    cursor:           inherit;
}

element-text {
    vertical-align:   0.5;
    background-color: inherit;
    text-color:       inherit;
    highlight:        bold #7E9CD8;
    cursor:           inherit;
}

error-message {
    padding:          12px 16px;
    background-color: @bg;
    border:           1px;
    border-color:     @crit;
    border-radius:    6px;
}
